<Window x:Class="PCInventory.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Выполняется операция" 
        Height="150" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Margin="15" CornerRadius="8" Background="{DynamicResource MaterialDesignCardBackground}">
        <StackPanel Margin="15">
            <TextBlock x:Name="txtStatus" 
                       Text="Выполняется операция..." 
                       Margin="0,0,0,15"
                       TextWrapping="Wrap"/>

            <ProgressBar x:Name="pbProgress" 
                         Height="25" 
                         Minimum="0" Maximum="100"
                         Value="0"/>

            <TextBlock x:Name="txtPercent" 
                       Text="0%" 
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</Window>