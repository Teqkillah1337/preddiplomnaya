<Window x:Class="PCInventory.NetworkScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сканирование сети" 
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Border Margin="20" CornerRadius="8" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="🔍 Сканирование локальной сети" 
                       FontSize="18" 
                       FontWeight="Bold"
                       Foreground="#7B1FA2"
                       Margin="0,0,0,20"/>

            <!-- Настройки сканирования -->
            <Border Grid.Row="1" BorderBrush="#E0E0E0" 
                    BorderThickness="0,0,0,1" Padding="0,0,0,20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Параметры сканирования" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <WrapPanel>
                        <TextBox x:Name="txtStartIP" 
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 Width="120" Margin="0,0,10,10" Text="192.168.1.1"/>

                        <TextBox x:Name="txtEndIP" 
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 Width="120" Margin="0,0,10,10" Text="192.168.1.255"/>

                        <TextBox x:Name="txtTimeout" 
                                 Style="{StaticResource MaterialDesignTextBox}"
                                 Width="100" Margin="0,0,10,10" Text="100"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox x:Name="cbScanPorts" 
                                  Content="Сканировать порты"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Margin="0,0,10,0"/>

                        <CheckBox x:Name="cbResolveNames" 
                                  Content="Определять имена"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  IsChecked="True"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Прогресс и результаты -->
            <Border Grid.Row="2" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Прогресс:" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBlock x:Name="txtProgress" Text="Ожидание запуска..."/>
                    </StackPanel>

                    <ProgressBar x:Name="pbScan" 
                                 Height="20" 
                                 Minimum="0" Maximum="100"
                                 Value="0"
                                 Margin="0,0,0,15"/>

                    <TextBlock Text="Обнаруженные компьютеры:" 
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <ListBox x:Name="lbDiscoveredComputers" 
                             Height="200"
                             BorderBrush="#E0E0E0"
                             BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" 
                                                   Text="🖥️"
                                                   FontSize="16"
                                                   Margin="0,0,10,0"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding ComputerName}" 
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding IPAddress}" 
                                                       Foreground="Gray" FontSize="12"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" 
                                                Content="📥"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="14"
                                                Cursor="Hand"
                                                ToolTip="Собрать информацию"
                                                Margin="5,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnStartScan" Content="Начать сканирование" Style="{StaticResource PrimaryButton}" Width="160"/>
                <Button x:Name="btnCancel" Content="Отмена" Style="{StaticResource SecondaryButton}" Width="120"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>