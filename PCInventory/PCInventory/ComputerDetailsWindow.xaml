<Window x:Class="PCInventory.ComputerDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Сведения о компьютере" 
        Height="828" Width="1308"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Border Margin="15" CornerRadius="8" Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка с информацией о компьютере -->
            <Border Grid.Row="0" 
                    Background="#E1BEE7"
                    CornerRadius="6" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" 
                               Text="🖥️"
                               FontSize="24"
                               Margin="0,0,15,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="txtComputerName" 
                                   Text="COMPUTER-01" 
                                   FontSize="18" FontWeight="Bold"/>

                        <WrapPanel Margin="0,5,0,0">
                            <TextBlock Text="IP: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtIP" Text="192.168.1.100" Margin="0,0,15,0"/>

                            <TextBlock Text="MAC: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtMAC" Text="Не определен" Margin="0,0,15,0"/>

                            <TextBlock Text="Статус: " FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtStatus" Text="Онлайн" Foreground="Green"/>
                        </WrapPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <Button x:Name="btnUpdateInfo" Content="Обновить" Style="{StaticResource SmallButton}" Width="147" Margin="0,0,0,5"/>
                        <Button x:Name="btnExportThis" Content="Экспортировать" Style="{StaticResource SmallButton}" Width="147" Margin="0,0,0,5"/>
                        <Button x:Name="btnSavePassport" Content="Сохранить JSON" Style="{StaticResource SmallButton}" Width="147"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Вкладки с информацией -->
            <TabControl x:Name="tabControl" Grid.Row="1" BorderThickness="0">
                <TabItem Header="🖥️ Аппаратная конфигурация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Процессор -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Процессор" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtCPUModel" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Оперативная память -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Оперативная память" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtRAM" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Материнская плата -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Материнская плата" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtMotherboard" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Видеокарта -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Видеокарта" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtGPU" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Диски -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Диски" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtDisks" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="⚙️ Системная информация">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <!-- Операционная система -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Операционная система" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <TextBlock x:Name="txtOS" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Производитель и модель -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Производитель" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <WrapPanel Margin="0,0,0,5">
                                        <TextBlock Text="Производитель: " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtManufacturer"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,5">
                                        <TextBlock Text="Модель: " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtModel"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <TextBlock Text="Серийный номер: " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtSerialNumber"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- Последнее обновление -->
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Информация" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <TextBlock Text="Последнее обновление: " FontWeight="SemiBold"/>
                                        <TextBlock x:Name="txtLastUpdate"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>